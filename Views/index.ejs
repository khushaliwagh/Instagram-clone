<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instagram Page</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <nav class="nav">
        <h1>INSTAGRAM PAGE</h1>
    </nav>

    <% for (let post of posts) { %>
        <div>
            <% if (post.image) { %>
                <div class="image-box">
                    <img src="/uploads/<%= post.image %>" alt="Post Image">
                    <div class="username">@<%= post.username %>
                            <p>
                                <%= post.content %>
                            </p>
                    </div>
                </div>

                <div class="i">
                  
                    <a href="/posts/<%= post.id %>">See in detail</a>
                    <a href="/posts/<%= post.id %>/edit">Edit</a>
                     <a href="/posts/new">Create Post</a>
                    <form class="a2" method="POST" action="/posts/<%= post.id %>?_method=DELETE">
                        <button style="background-image: linear-gradient(to bottom, rgb(255, 132, 0), rgb(221, 0, 255));" type="submit">Delete</button>
                    </form>

                  
                </div>
                <% } %>
        </div>
        <% } %>
</body>

</html>